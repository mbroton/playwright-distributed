# Control plane HTTP URL
SERVER_URL=http://localhost:8080
# Optional bearer key. Leave unset while the server uses bootstrap mode.
# WORKER_API_KEY=pwd_example

# Supported values: chromium, firefox, webkit
BROWSER_TYPE=chromium
# Port for browser relay connections
PORT=3131
# Optional address hostname. The default is the machine or container hostname.
# PRIVATE_HOSTNAME=worker
# Maximum number of concurrent browser sessions
MAX_SLOTS=5
HEADLESS=true

# Time values use seconds
HEARTBEAT_INTERVAL=5
DRAIN_TIMEOUT=300

LOG_LEVEL=info
# Supported values: json, text
LOG_FORMAT=json
